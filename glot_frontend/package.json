{
  "name": "glot",
  "version": "1.0.0",
  "description": "glot",
  "main": "js/main.ts",
  "scripts": {
    "dev": "concurrently -k \"npm run watch:build\" \"vite\"",
    "watch:build": "watchexec --watch src --watch ../glot_core/src --watch ../glot_web/src --watch gleam.toml --watch ../glot_core/gleam.toml --watch ../glot_web/gleam.toml --exts gleam,toml,mjs -- ../build_frontend.sh",
    "build": "vite build",
    "test": "npm run check:boundaries && npm run check:css && npm run test:gleam && npm run test:javascript",
    "check:boundaries": "node scripts/check-managed-boundaries.mjs",
    "check:css": "node scripts/check-css-architecture.mjs",
    "test:gleam": "gleam test",
    "test:javascript": "node --test js/custom_elements/*.test.mjs src/glot_frontend/api/*.test.mjs src/glot_frontend/platform/*.test.mjs",
    "test:browser": "playwright test",
    "test:browser:install": "playwright install --with-deps chromium firefox webkit"
  },
  "type": "module",
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {},
  "devDependencies": {
    "concurrently": "^9.2.1",
    "vite": "^7.3.0",
    "@playwright/test": "^1.50.0"
  }
}
